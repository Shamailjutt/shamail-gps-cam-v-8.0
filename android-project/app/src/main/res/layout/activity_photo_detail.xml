<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_deep"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/navy_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnBackDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gold_bright" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/gold_bright"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewMetadataHistory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Info &amp; History"
            android:textColor="@color/gold_bright"
            android:textSize="11sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/gold_primary" />
    </LinearLayout>

    <!-- Full Photo / Video Media View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <VideoView
            android:id="@+id/vvFullVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivFullPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Watermarked GPS Media"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btnPlayPauseVideo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_navy"
            android:contentDescription="Play or Pause Video"
            android:padding="12dp"
            android:src="@drawable/ic_play_circle"
            android:visibility="gone"
            app:tint="@color/gold_bright" />
    </FrameLayout>

    <!-- Pre-Save Custom Watermark Preview Bar (Admin Only, hidden until previewing) -->
    <LinearLayout
        android:id="@+id/layoutPreviewConfirmBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_card"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPreviewBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Previewing custom watermark · Original file will not be overwritten"
            android:textColor="@color/gold_bright"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressVideoProcessing"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progressTint="@color/gold_bright"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveEditedCopy"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.35"
                android:text="Save New Copy"
                android:textColor="@color/gold_on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/gold_primary"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEditPreview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.85"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/navy_border" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Share, Delete & Admin Edit Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_surface"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/layoutAdminEditActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPhotoDateTime"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Edit Date &amp; Time"
                android:textColor="@color/gold_bright"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_schedule"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/gold_bright"
                app:strokeColor="@color/gold_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePhotoLocation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Change Location"
                android:textColor="@color/gold_bright"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_map_pin"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/gold_bright"
                app:strokeColor="@color/gold_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSharePhoto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Share Photo"
                android:textColor="@color/gold_on_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/gold_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="@color/gold_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeletePhoto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textColor="@color/status_red"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/status_red"
                app:strokeColor="@color/status_red" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
